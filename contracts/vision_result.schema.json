{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chest X-ray vision result",
  "type": "object",
  "required": ["image_id", "quality", "findings"],
  "additionalProperties": false,
  "properties": {
    "image_id": {"type": "string"},
    "quality": {
      "type": "object",
      "required": ["blur", "brightness", "contrast", "is_chest_xray", "status", "issues"],
      "additionalProperties": false,
      "properties": {
        "blur": {"type": "number"},
        "brightness": {"type": "number", "minimum": 0, "maximum": 1},
        "contrast": {"type": "number", "minimum": 0, "maximum": 1},
        "is_chest_xray": {"type": "boolean"},
        "status": {"enum": ["good", "poor"]},
        "issues": {"type": "array", "items": {"type": "string"}}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "if": {"properties": {"score": {"exclusiveMaximum": 0.3}}, "required": ["score"]},
            "then": {"properties": {"region": {"type": "null"}, "heatmap_path": {"type": "null"}}}
          }
        ],
        "type": "object",
        "required": ["label", "score", "region", "heatmap_path"],
        "additionalProperties": false,
        "properties": {
          "label": {"enum": ["Pneumonia", "Effusion", "Pneumothorax"]},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "region": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["x", "y", "w", "h"],
                "additionalProperties": false,
                "properties": {
                  "x": {"type": "number", "minimum": 0, "maximum": 1},
                  "y": {"type": "number", "minimum": 0, "maximum": 1},
                  "w": {"type": "number", "minimum": 0, "maximum": 1},
                  "h": {"type": "number", "minimum": 0, "maximum": 1}
                }
              }
            ]
          },
          "heatmap_path": {"type": ["string", "null"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"quality": {"properties": {"is_chest_xray": {"const": false}}}}, "required": ["quality"]},
      "then": {"properties": {"findings": {"maxItems": 0}}}
    }
  ]
}
